#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <unistd.h>

int main(void) {
    time_t now = time(NULL);
    struct tm *t = localtime(&now);

    int hour = t->tm_hour;
    int minute = t->tm_min;
    int second = t->tm_sec;

    while (1) {
        system("cls");
        printf("%02d:%02d:%02d\n", hour, minute, second);
        fflush(stdout);

        sleep(1);

        second++;
        if (second == 60) {
            second = 0;
            minute++;
        }
        if (minute == 60) {
            minute = 0;
            hour++;
        }
        if (hour == 24) {
            hour = 0;
        }
    }

    return 0;
}